# --- Base de données Neon -----------------------------------------------
# Chaîne de connexion "pooled" fournie par Neon (dashboard > Connection string).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Authentification admin ---------------------------------------------
# Identifiant unique partagé par la présidente, la trésorière et la secrétaire.
ADMIN_EMAIL="bureau@banatsportclub.fr"
ADMIN_PASSWORD="change-moi"

# Clé secrète utilisée pour signer le cookie de session (32 caractères minimum).
# Générer avec : openssl rand -base64 32
SESSION_SECRET="remplace-par-une-chaine-aleatoire-de-32-caracteres-minimum"
