# --- Base de données Neon -----------------------------------------------
# Chaîne de connexion "pooled" fournie par Neon (dashboard > Connection string).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Authentification admin ---------------------------------------------
# Identifiant unique partagé par la présidente, la trésorière et la secrétaire.
ADMIN_EMAIL="bureau@banatsportclub.fr"
ADMIN_PASSWORD="change-moi"

# Clé secrète utilisée pour signer le cookie de session (32 caractères minimum).
# Générer avec : openssl rand -base64 32
SESSION_SECRET="remplace-par-une-chaine-aleatoire-de-32-caracteres-minimum"

# --- Paiement en ligne Mollie -------------------------------------------
# Clé API Mollie. Commencer OBLIGATOIREMENT par la clé TEST (préfixe "test_").
# La clé LIVE (préfixe "live_") ne doit être posée qu'au moment de la mise en
# production réelle, une fois les tests terminés.
# Cette clé est strictement serveur : elle n'est jamais envoyée au navigateur.
# Si elle est absente, le paiement par carte est simplement masqué sur le site
# et l'inscription continue de fonctionner (virement / chèque / espèces).
MOLLIE_API_KEY="test_remplace-par-ta-cle-mollie-de-test"

# --- Emails transactionnels Resend --------------------------------------
# Clé API Resend (préfixe "re_"), strictement serveur elle aussi.
# Si elle est absente, aucun email n'est envoyé mais l'inscription et le
# paiement continuent de fonctionner normalement.
RESEND_API_KEY="re_remplace-par-ta-cle-resend"

# Expéditeur des emails, sur un domaine vérifié dans Resend.
RESEND_FROM_EMAIL="Banat Sport Club <bureau@banatsportclub.fr>"

# --- URL publique de l'application --------------------------------------
# Utilisée pour construire l'URL de retour Mollie et l'URL du webhook
# (https://…/api/webhooks/mollie). En local, laisser l'URL de dev.
# Sur Vercel, VERCEL_URL est utilisée automatiquement si APP_URL est absente,
# mais il est plus sûr de définir APP_URL sur le domaine définitif.
APP_URL="http://localhost:3000"
